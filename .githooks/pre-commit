#!/usr/bin/env bash
# Pre-commit hook: auto-bump the deploy banner on the HTML files in THIS commit,
# so the deployed banner reflects actual commit time.
#
# SCOPE-AWARE (June 17): stamps + re-stages ONLY the HTML files already staged in
# this commit — NOT always index.html + pm-studio-DrV.html. The old "always both"
# form cross-touched the other app's banner, which broke parallel-session /
# worktree isolation (it injected pm-studio's stamp into Big Game commits).
#
# Enable for this repo (one-time):
#   git config core.hooksPath .githooks
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
STAGED=$(git diff --cached --name-only)

# Which deployable HTML files are in this commit? (Pure docs/script/CSS commits
# get nothing — no noisy banner churn.)
HTML_STAGED=$(echo "$STAGED" | grep -E '^(index\.html|pm-studio-DrV\.html|biggame\.html)$' || true)
if [ -n "$HTML_STAGED" ]; then
    # Word-split on the newline-separated list (our HTML filenames have no spaces).
    bash "$REPO_ROOT/scripts/bump-trial.sh" $HTML_STAGED
    git add -- $HTML_STAGED >/dev/null 2>&1 || true
fi
